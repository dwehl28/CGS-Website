# CGL billing template. Copy to a private ignored .env.local file.
# Keep credentials blank here. Sandbox and production resources never mix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application identifier; this is not an access token or secret.
# Hosted checkout does not require a browser Square SDK or NEXT_PUBLIC Square key.
CGL_SQUARE_APPLICATION_ID=sandbox-sq0idb-coifDq2jybhW8YXqBoxAyw
CGL_SQUARE_ENVIRONMENT=sandbox
CGL_SQUARE_ACCESS_TOKEN=
CGL_SQUARE_LOCATION_ID=
CGL_SQUARE_MERCHANT_ID=
CGL_SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact reachable staging HTTPS URL; must match Square's registered notification URL.
CGL_SQUARE_WEBHOOK_URL=

# Fail closed. Enable only after reviewed staging setup and applicable approval.
CGL_SQUARE_CHECKOUT_ENABLED=false
CGL_SQUARE_SANDBOX_TESTING_ENABLED=false
CGL_SQUARE_TERMS_APPROVED=false
CGL_SQUARE_TERMS_VERSION=

# Production credentials use dedicated names so a Sandbox token or webhook key
# cannot be reused accidentally. Keep production selected and live gates false
# until the merchant, location, catalogue, webhook and low-value launch test pass.
CGL_SQUARE_PRODUCTION_APPLICATION_ID=
CGL_SQUARE_PRODUCTION_ACCESS_TOKEN=
CGL_SQUARE_PRODUCTION_LOCATION_ID=
CGL_SQUARE_PRODUCTION_MERCHANT_ID=
CGL_SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
CGL_SQUARE_PRODUCTION_WEBHOOK_URL=
CGL_SQUARE_LIVE_PAYMENTS_ENABLED=false
CGL_SQUARE_LIVE_RECURRING_ENABLED=false

# Independent server secret for protected CGL maintenance/recovery jobs.
CGL_JOB_SECRET=
# Vercel attaches this secret to its daily Square recovery invocation.
CRON_SECRET=

# Official Simulator Golf Tour Club Admin API. The SGT password is never stored;
# the rotating API key is held in Supabase Vault after the one-time connection.
CGL_SGT_CLUB_SLUG=CGSBunker
CGL_SGT_SYNC_SECRET=
